# Database connection string (PostgreSQL with psycopg v3 driver or SQLite fallback)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# JWT Secret Key for authentication token encoding/decoding
SECRET_KEY=replace-with-a-secure-random-secret-key

# Fernet symmetric key for encrypting sensitive credentials (e.g. IMAP passwords) at rest
FERNET_KEY=replace-with-a-fernet-key-e.g.-Fernet.generate_key().decode()

# Redis URL for Celery workers & background scraping tasks
REDIS_URL=redis://localhost:6379/0

# Allowed CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
